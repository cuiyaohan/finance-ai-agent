# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交
#
# ⚠️ 变量名必须与 v1-invest-intel/src/main/resources/application.yml 保持一致，
#    Spring Boot 直接按SPRING_AI_OPENAI_* 读取，改名会导致模型调用 401 且静默降级。

# 智谱 GLM（主栈，OpenAI 兼容）
SPRING_AI_OPENAI_API_KEY=你的智谱Key
SPRING_AI_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认 glm-4.5-flash（实测稳定）；免费备选 glm-4.7-flash（高峰期限流严重，慎用于演示）
SPRING_AI_OPENAI_MODEL=glm-4.5-flash

# 备用：阿里云百炼 DashScope（客户指定阿里云时才配）
# DASHSCOPE_API_KEY=